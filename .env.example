PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/credit_card_tracker?retryWrites=true&w=majority
JWT_SECRET=your_production_jwt_secret_here
JWT_EXPIRES_IN=7d
# 32-byte hex key (generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your_64_char_hex_encryption_key_here
CLIENT_URL=https://your-frontend-domain.com
